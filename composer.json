{
    "name": "msstc4php/vo-base-laravel",
    "description": "Laravel Eloquent cast, validation rule, request input and route parameters for msstc4php/vo-base value objects.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "value-object",
        "laravel",
        "eloquent",
        "cast",
        "validation",
        "bridge",
        "ddd"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/msstc4php/vo-base"
        }
    ],
    "require": {
        "php": ">=8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "msstc4php/vo-base": "^1.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.76",
        "illuminate/translation": "^13.0",
        "laravel/framework": "^13.0",
        "orchestra/testbench": "^11.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": ">=11.0",
        "rector/rector": "^2.1",
        "roave/security-advisories": "dev-latest"
    },
    "suggest": {
        "laravel/framework": "For $request->valueObject(), the ValidatedValueObjects form request trait and value objects as route parameters."
    },
    "autoload": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\Laravel\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Maxim Shamaev",
            "email": "maxim.shamaev@gmail.com"
        }
    ],
    "extra": {
        "bundle-standard": {
            "kind": "library",
            "runtime": "php84"
        },
        "laravel": {
            "providers": [
                "MSSTC4PHP\\ValueObject\\Laravel\\ValueObjectServiceProvider"
            ]
        }
    }
}
